{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/lantern/static/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/static/:path"
    },
    {
      "source": "/lantern/array/:path(.*)",
      "destination": "https://us-assets.i.posthog.com/array/:path"
    },
    {
      "source": "/lantern/:path(.*)",
      "destination": "https://us.i.posthog.com/:path"
    },
    {
      "source": "/admin/feedback",
      "destination": "/admin.html?view=feedback"
    },
    {
      "source": "/admin/edit",
      "destination": "/admin.html?view=edit"
    },
    {
      "source": "/admin/approve",
      "destination": "/admin.html?view=confirm"
    },
    {
      "source": "/:slug([^/]+)",
      "destination": "/opportunities-detail?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://cdn.jsdelivr.net https://unpkg.com https://vercel.live https://*.vercel.live; style-src 'self' 'unsafe-inline' https://unpkg.com https://fonts.googleapis.com; connect-src 'self' https://*.supabase.co https://challenges.cloudflare.com https://unpkg.com https://nominatim.openstreetmap.org https://router.project-osrm.org; frame-src https://challenges.cloudflare.com https://vercel.live; img-src 'self' data: https://*.tile.openstreetmap.org https://unpkg.com; font-src 'self' https://fonts.gstatic.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'"
        },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=(), payment=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "functions": {
    "api/*.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/opportunities/detail.html",
      "has": [{ "type": "query", "key": "slug" }],
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/opportunities/detail.html",
      "destination": "/opportunities-detail",
      "permanent": true
    },
    {
      "source": "/opportunities-detail",
      "has": [{ "type": "query", "key": "slug" }],
      "destination": "/:slug",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "query", "key": "view", "value": "feedback" }],
      "destination": "/admin/feedback",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "query", "key": "view", "value": "edit" }],
      "destination": "/admin/edit",
      "permanent": true
    },
    {
      "source": "/admin",
      "has": [{ "type": "query", "key": "view", "value": "confirm" }],
      "destination": "/admin/approve",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/send-digest",
      "schedule": "0 8 * * 1"
    }
  ]
}
